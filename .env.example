# Nebius Token Factory (https://tokenfactory.nebius.com/project/api-keys)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Model roles (IDs verified against GET /v1/models on 2026-10-27)
MODEL_PLANNER=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_VL=nvidia/Nemotron-3.5-Super-VL
MODEL_FAST=nvidia/Nemotron-3_5-Lightning

# Local Blender MCP server ("MCP for Blender Pro")
BLENDER_MCP_URL=http://127.0.0.1:9880/mcp
# Put the MCP auth token in ~/.blender_mcp_token (or set BLENDER_MCP_TOKEN_FILE),
# not in this file. Leave blank to use the token file.
BLENDER_MCP_TOKEN=
